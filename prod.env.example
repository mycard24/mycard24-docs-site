# Production env for mycard24-docs-site — the filled-in version lives in the PROD_ENV variable on
# the repository's production environment, and CD writes it to /opt/mycard24-docs-site/.env.
#
# Nothing here is secret: the documentation is public. PROD_ENV is a variable, the same split every
# repo here uses — SSH_KEY is the only secret.
#
# IMAGE and IMAGE_TAG are appended by CD and must not be set here.

# Loopback port the host nginx proxies to. Must match deploy/nginx/docs.mycard24.ru.conf.
DOCS_PORT=8088

DOCS_MEMORY_LIMIT=128M
